{
  "name": "balloon-writer-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd packages/balloon-writer build",
    "build:demo": "bun run build && bun run --cwd demo build",
    "start": "bun run --cwd demo preview"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
