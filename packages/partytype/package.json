{
  "name": "partytype",
  "version": "0.1.0",
  "description": "A <textarea> or <input> whose text floats as physics-simulated foil letter balloons. Vanilla core, React adapter.",
  "keywords": [
    "react",
    "textarea",
    "input",
    "balloons",
    "three",
    "react-three-fiber",
    "webgpu",
    "rapier"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./sound": {
      "types": "./dist/soundTuning.d.ts",
      "import": "./dist/soundTuning.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "NODE_ENV=production bun scripts/build.ts",
    "dev": "NODE_ENV=production bun scripts/build.ts --watch",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "three": "^0.184.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d": "0.19.2",
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.14",
    "@types/three": "^0.184.0",
    "opentype.js": "1.3.4",
    "react": "^19.2.5",
    "three": "^0.184.0",
    "typescript": "^6.0.3"
  }
}
