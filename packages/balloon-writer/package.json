{
  "name": "balloon-writer",
  "version": "0.1.0",
  "description": "Drop-in React <textarea> and <input> whose text floats as physics-simulated foil letter balloons.",
  "keywords": [
    "react",
    "textarea",
    "input",
    "balloons",
    "three",
    "react-three-fiber",
    "webgpu",
    "rapier"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sound": {
      "types": "./dist/soundTuning.d.ts",
      "import": "./dist/soundTuning.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "NODE_ENV=production bun scripts/build.ts",
    "dev": "NODE_ENV=production bun scripts/build.ts --watch",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "opentype.js": "1.3.4"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "typescript": "^6.0.3"
  }
}
